{
  "apiVersion": "storage.sunmoonai.com/v1alpha1",
  "kind": "ObjectStorageAccess",
  "metadata": {
    "name": "knowbase-backend"
  },
  "spec": {
    "provider": "platform-s3",
    "environment": "development",
    "app": "knowbase-app",
    "backend": "knowbase-backend",
    "namespace": "app-platform-dev",
    "secretName": "knowbase-backend-s3",
    "configMapName": "knowbase-backend-s3",
    "region": "us-east-1",
    "forcePathStyle": true,
    "useTLS": false,
    "deletionPolicy": "Retain",
    "buckets": [
      {
        "name": "development-knowfeed-originals",
        "permissions": [
          "read"
        ],
        "versioning": true,
        "objectLock": false
      },
      {
        "name": "development-knowbase-admin-assets",
        "permissions": [
          "read",
          "write",
          "delete",
          "list"
        ],
        "versioning": true,
        "objectLock": false
      },
      {
        "name": "development-knowbase-datasets",
        "permissions": [
          "read"
        ],
        "versioning": true,
        "objectLock": false
      }
    ]
  }
}
