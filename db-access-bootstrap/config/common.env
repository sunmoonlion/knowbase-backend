# Common switches for the unified Knowbase Backend database bootstrap.
# Service/Secret names use "-"; database/user identifiers use "_".

ENABLE_POSTGRESQL=true
ENABLE_REDIS=true
ENABLE_MONGODB=false

NAMESPACE=app-platform-dev
# 默认使用本 backend 目录下 db-provisioner（便于整仓单独迁出）；可用环境变量 DBCTL_BIN 覆盖
if [[ -z "${DBCTL_BIN:-}" ]]; then
  DBCTL_BIN="$(cd "${BOOTSTRAP_DIR}/.." && pwd)/db-provisioner/bin/dbctl"
fi

# dbctl 的 PostgreSQL 临时 client pod 镜像按集群默认解析。
# 默认不继承外层 PG_CLIENT_IMAGE，避免旧环境变量把 Harbor 地址错带到当前集群；
# 如确需覆盖，使用 APP_PG_CLIENT_IMAGE。
if [[ -n "${APP_PG_CLIENT_IMAGE:-}" ]]; then
  PG_CLIENT_IMAGE="${APP_PG_CLIENT_IMAGE}"
else
  _cluster_for_pg="${CLUSTER:-${K8S_TARGET_MODE:-${TARGET_MODE:-}}}"
  if [[ "$(printf '%s' "$_cluster_for_pg" | tr '[:lower:]' '[:upper:]')" == "KIND" ]]; then
    PG_CLIENT_IMAGE="harbor.sunmoonai.com:30443/k8s-images/postgresql:17.6.0-debian-12-r4"
  else
    PG_CLIENT_IMAGE="harbor.sunmoonai.com:30443/k8s-images/postgresql:17.6.0-debian-12-r4"
  fi
  unset _cluster_for_pg
fi
export PG_CLIENT_IMAGE

# Redis 临时 client pod 镜像也按集群默认解析。
# 当前 Kind 和远程集群都通过 harbor.sunmoonai.com:30443 访问 Harbor；如需覆盖，使用 APP_REDIS_CLIENT_IMAGE。
if [[ -n "${APP_REDIS_CLIENT_IMAGE:-}" ]]; then
  REDIS_CLIENT_IMAGE="${APP_REDIS_CLIENT_IMAGE}"
else
  _cluster_for_redis="${CLUSTER:-${K8S_TARGET_MODE:-${TARGET_MODE:-}}}"
  if [[ "$(printf '%s' "$_cluster_for_redis" | tr '[:lower:]' '[:upper:]')" == "KIND" ]]; then
    REDIS_CLIENT_IMAGE="harbor.sunmoonai.com:30443/k8s-images/redis:8.2.1-debian-12-r0"
  else
    REDIS_CLIENT_IMAGE="harbor.sunmoonai.com:30443/k8s-images/redis:8.2.1-debian-12-r0"
  fi
  unset _cluster_for_redis
fi
export REDIS_CLIENT_IMAGE

MONGO_CLIENT_IMAGE="${APP_MONGO_CLIENT_IMAGE:-harbor.sunmoonai.com:30443/k8s-images/mongodb:8.0.13-debian-12-r0}"
export MONGO_CLIENT_IMAGE

BASE_ENV_TEMPLATE=${BOOTSTRAP_DIR}/config/base.env.template
OUT_ENV=${BOOTSTRAP_DIR}/.env.local.db
K8S_OUT_ENV=${BOOTSTRAP_DIR}/.env.local.k8s.db
STRICT_FILE_CHECK=true

PG_CONFIG=${BOOTSTRAP_DIR}/config/postgresql.external.env
REDIS_CONFIG=${BOOTSTRAP_DIR}/config/redis.external.env
MONGO_CONFIG=${BOOTSTRAP_DIR}/config/mongodb.external.env
PG_K8S_CONFIG=${BOOTSTRAP_DIR}/config/postgresql.k8s.env
REDIS_K8S_CONFIG=${BOOTSTRAP_DIR}/config/redis.k8s.env
MONGO_K8S_CONFIG=${BOOTSTRAP_DIR}/config/mongodb.k8s.env
