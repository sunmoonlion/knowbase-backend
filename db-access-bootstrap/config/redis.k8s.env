SERVICE_NAME=knowbase-backend
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=redis

# ⚠️ 部署前必须修改：填写实际的 k8s Redis Service DNS
# 格式：<service-name>.<data-namespace>.svc.cluster.local
# 示例：redis-sunmoonai-master.data-platform-dev.svc.cluster.local
DB_HOST=redis-sunmoonai-master.data-platform-dev.svc.cluster.local
DB_PORT=6379
APP_DB_NAME=0
APP_DB_USER=knowbase_backend
APP_DB_PASSWORD=change_me_via_secret_manager

REDIS_ADMIN_USER=default
REDIS_ADMIN_PASSWORD=change_me_via_secret_manager
REDIS_DB_INDEX=0
REDIS_AUTH_ONLY=false
REDIS_KEY_PREFIX="knowbase:*"
REDIS_ACL_CATEGORY="+@read +@write +@connection +@hash +@string +@list +@set +@sortedset"

OUTPUT_NAMESPACE=app-platform-dev
OUTPUT_SECRET_NAME=knowbase-backend-redis-conn
